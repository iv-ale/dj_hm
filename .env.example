# Шаблон локальных настроек. Скопируйте файл в .env и подставьте свои значения:
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS / Linux)

# Секретный ключ Django. Сгенерировать новый можно так:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me

# True — режим разработки (подробные страницы ошибок).
# False — боевой режим: при ошибке 404 показывается templates/404.html.
DEBUG=True

# Список хостов через запятую. 127.0.0.1/localhost — доступ с этого компьютера,
# IP компьютера в Wi-Fi сети (например 192.168.1.10) нужен для доступа с телефона.
ALLOWED_HOSTS=127.0.0.1,localhost
